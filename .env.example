# Copy this to .env.local and fill in your values
# .env.local is gitignored — never commit real credentials

# ── Database (Supabase) ────────────────────────────────────────────────────────
# Pooled connection (port 6543) — used at runtime by Prisma client
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma migrations only
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Vercel Blob Storage (for club logo uploads) ────────────────────────────────
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"
